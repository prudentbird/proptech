{
  "name": "proptech",
  "version": "1.0.0",
  "description": "Property Listings API built with Effect and PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
